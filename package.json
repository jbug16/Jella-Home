{
  "name": "jella-home",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "tsx scripts/dev-with-local-supabase.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/run-e2e-local.ts",
    "test:e2e:raw": "playwright test",
    "start:e2e": "tsx scripts/start-with-local-supabase.ts",
    "test:db": "supabase test db",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "supabase:advisors": "supabase db advisors --linked --type all",
    "ensure:shared-login": "tsx scripts/ensure-shared-login.ts",
    "provision:household": "tsx scripts/provision-household.ts",
    "provision:add-member": "tsx scripts/add-household-member.ts",
    "verify:hosted-access": "tsx scripts/verify-hosted-access.ts",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:e2e"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "radix-ui": "^1.6.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.5",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
