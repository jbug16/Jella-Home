# Jella Home environment variables
#
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local` or any real secrets.
#
# Local Supabase (Milestone 2 default for migrations / RLS):
#   1. Ensure Colima (or another Docker runtime) is running: `colima status`
#   2. npx supabase start
#   3. npx supabase status -o env
#   4. Map values into the variable names below:
#        API URL            -> NEXT_PUBLIC_SUPABASE_URL
#        PUBLISHABLE_KEY    -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#                            (or local ANON_KEY JWT if publishable is absent)
#        SECRET_KEY         -> SUPABASE_SECRET_KEY
#                            (or local SERVICE_ROLE_KEY JWT if secret is absent)
#
# Local config note: analytics is disabled in supabase/config.toml because the
# analytics/vector container cannot mount Colima's docker.sock path.
#
# Hosted Supabase:
#   Use the project's URL, publishable key, and secret key from the dashboard.
#   Disable public sign-ups in Auth settings.
#
# Environment separation (see docs/DEPLOYMENT.md):
#   local      → values from `supabase status` (this file / .env.local)
#   staging    → Netlify context `branch:staging` + dedicated staging project
#   production → Netlify context `production` + hosted jella-home project
# Never copy .env.local into Git or reuse production keys on staging.

NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-local-anon-key"
SUPABASE_SECRET_KEY="your-secret-or-local-service-role-key"

# Household calendar timezone for date-only “today” (server + client).
# Defaults to America/New_York when unset.
NEXT_PUBLIC_HOUSEHOLD_TIME_ZONE="America/New_York"

# Hosted provisioning (scripts/provision-household.ts). Do not commit values.
# Prefer one shared login for production (member 1 only).
# PROVISION_HOUSEHOLD_NAME="Our Home"
# PROVISION_MEMBER_1_EMAIL=""
# PROVISION_MEMBER_1_PASSWORD=""
# PROVISION_MEMBER_1_DISPLAY_NAME="Household"
# Optional second member (local/verification only):
# PROVISION_MEMBER_2_EMAIL=""
# PROVISION_MEMBER_2_PASSWORD=""
# PROVISION_MEMBER_2_DISPLAY_NAME=""

# Add a member to an existing household (scripts/add-household-member.ts).
# PROVISION_HOUSEHOLD_ID=""
# PROVISION_MEMBER_EMAIL=""
# PROVISION_MEMBER_PASSWORD=""
# PROVISION_MEMBER_DISPLAY_NAME=""
# PROVISION_MEMBER_ROLE="member"

# Hosted equal-permission checks (scripts/verify-hosted-access.ts).
# VERIFY_MEMBER_1_EMAIL=""
# VERIFY_MEMBER_1_PASSWORD=""
# VERIFY_MEMBER_2_EMAIL=""
# VERIFY_MEMBER_2_PASSWORD=""
# VERIFY_NON_MEMBER_EMAIL=""
# VERIFY_NON_MEMBER_PASSWORD=""
