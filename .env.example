# Jella Home environment variables
#
# Copy this file to `.env.local` and fill in real values. Never commit
# `.env.local` or any real secrets. None of these are required to run the
# Milestone 1 foundation shell; they are consumed by later milestones
# (authentication in M2, Google Sheets in M3).

# Google service account used for server-side Sheets access (M3).
GOOGLE_SERVICE_ACCOUNT_EMAIL="jella-home@your-project.iam.gserviceaccount.com"

# The service account's private key. Keep it double-quoted on a single line
# with escaped newlines (\n); the app normalizes these to real newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyLine1\nMIIExampleKeyLine2\n-----END PRIVATE KEY-----\n"

# The spreadsheet the service account is allowed to read/write (M3).
GOOGLE_SHEETS_SPREADSHEET_ID="your-google-sheet-id"

# Comma-separated allowlist of the household email addresses permitted to sign
# in (M2). Only the two intended users should be listed.
AUTH_ALLOWLIST="jenna@example.com,partner@example.com"
